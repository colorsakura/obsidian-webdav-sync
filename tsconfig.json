{
	"compilerOptions": {
		"strict": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2022",
		"allowJs": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"lib": ["DOM", "ES2022"],
		"paths": {
			"~/*": ["./src/*"],
			"~": ["./src"]
		}
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "**/*.test.ts", "__mocks__"]
}
